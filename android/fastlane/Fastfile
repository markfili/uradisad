default_platform(:android)

PROJECT_ROOT = File.expand_path("../..", __dir__)
AAB_PATH = File.join(PROJECT_ROOT, "build/app/outputs/bundle/release/app-release.aab")

platform :android do
  desc "Check that the service-account key can reach this app on Google Play"
  lane :check_access do
    validate_play_store_json_key
  end

  desc "Download the current store listing into fastlane/metadata (run once, then edit and commit)"
  lane :fetch_metadata do
    download_from_play_store
  end

  desc "Build a signed release AAB with the FVM-pinned Flutter"
  lane :build do
    Dir.chdir(PROJECT_ROOT) do
      sh("fvm", "flutter", "build", "appbundle", "--release")
    end
  end

  # Release lanes also upload the listing text and release notes from
  # fastlane/metadata; images and screenshots only go up via the metadata lane.

  desc "Build and upload to the internal testing track. Options: priority:0-5 (4+ forces the in-app update)"
  lane :internal do |options|
    build
    upload_to_play_store(
      track: "internal",
      aab: AAB_PATH,
      in_app_update_priority: options[:priority]&.to_i,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  desc "Build and submit to production. Options: rollout:0.2 staged rollout, draft:true draft only, priority:0-5 (4+ forces the in-app update)"
  lane :production do |options|
    build
    upload_to_play_store(
      track: "production",
      aab: AAB_PATH,
      release_status: options[:draft] ? "draft" : (options[:rollout] ? "inProgress" : "completed"),
      rollout: options[:rollout]&.to_s,
      in_app_update_priority: options[:priority]&.to_i,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  desc "Promote the latest internal release to production without rebuilding"
  lane :promote do
    upload_to_play_store(
      track: "internal",
      track_promote_to: "production",
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true,
    )
  end

  desc "Upload listing text, images and screenshots. Needs a release on the track; pass version_code:N if the latest isn't found"
  lane :metadata do |options|
    upload_to_play_store(
      version_code: options[:version_code],
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_changelogs: true,
    )
  end
end
